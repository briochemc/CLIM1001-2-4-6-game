{
  "name": "clim1001-2-4-6-game",
  "version": "0.1.0",
  "private": true,
  "description": "Wason's 2-4-6 rule-discovery game as an LTI tool for Moodle, on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
